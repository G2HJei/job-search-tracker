package views

import (
	"strconv"

	"github.com/G2HJei/job-search-tracker/internal/model"
)

templ CalendarPage(p Page, c CalendarData) {
	@Layout(p) {
		<div class="page-head">
			<h1>Calendar</h1>
			<a href="/calendar.ics" role="button" class="secondary outline" download>Download .ics</a>
		</div>
		<p class="muted small">
			The .ics file has every future event on active applications. Import it into Outlook or Google Calendar,
			or subscribe to <code>{ c.ICSURL }</code> from a calendar app on this computer.
		</p>
		<section>
			<h2>Overdue <span class="count">{ strconv.Itoa(len(c.Overdue)) }</span></h2>
			if len(c.Overdue) == 0 {
				<p class="muted">Nothing overdue.</p>
			} else {
				<ul class="events">
					for _, e := range c.Overdue {
						@eventItem(e, c.Titles, c.Today, true)
					}
				</ul>
			}
		</section>
		<section>
			<h2>Upcoming</h2>
			if len(c.Days) == 0 {
				<p class="muted">Nothing scheduled.</p>
			} else {
				@monthAgenda(c)
			}
		</section>
	}
}

templ monthAgenda(c CalendarData) {
	for i, day := range c.Days {
		if i == 0 || day.Day.Month() != c.Days[i-1].Day.Month() {
			<h3 class="month">{ day.Day.Format("January 2006") }</h3>
		}
		@agenda([]model.DayEvents{day}, c.Titles, c.Today)
	}
}
